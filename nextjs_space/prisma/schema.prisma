// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// NextAuth.js models
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation("accounts", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model User {
  id                    String   @id @default(cuid())
  name                  String?
  email                 String?  @unique
  emailVerified         DateTime?
  password              String?  // For email-password auth
  phone                 String?  // Phone number for emergency dialer
  image                 String?
  city                  String?  // optional city
  preferredPhoneStations String[] @default([]) // deprecated
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  accounts              Account[]        @relation("accounts")
  sessions              Session[]
  emergencyContacts     EmergencyContact[]
  savedRoutes           SavedRoute[]
  safetyReports         SafetyReport[]

  @@index([email])
  @@index([city])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model EmergencyContact {
  id                 String   @id @default(cuid())
  userId             String
  email              String
  name               String
  relationship       String   // friend, family, police, etc.
  isPrimaryPoliceContact Boolean @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
}

model SavedRoute {
  id                String   @id @default(cuid())
  userId            String
  startPoint        String   // JSON: {lat, lon, name}
  endPoint          String   // JSON: {lat, lon, name}
  routeType         String   // "safest", "balanced", "fastest"
  safetyScore       Float
  distance          Float    // in km
  duration          Float    // in minutes
  routeData         String   @db.Text // JSON: polyline, nodes, etc.
  savedAt           DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([savedAt])
}

model SafetyReport {
  id                       String   @id @default(cuid())
  userId                   String
  latitude                 Float
  longitude                Float
  unsafeZoneDescription    String
  severity                 String   // "low", "medium", "high"
  timestamp                DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([timestamp])
  @@index([latitude, longitude])
}

model OtpToken {
  id        String   @id @default(cuid())
  email     String   @unique
  code      String
  name      String?
  expiresAt DateTime
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

model PoliceStation {
  id           String   @id @default(cuid())
  city         String   // "delhi" or "mumbai"
  name         String
  latitude     Float
  longitude    Float
  phoneNumber  String
  email        String?
  address      String
  createdAt    DateTime @default(now())

  @@unique([city, name])
  @@index([city])
  @@index([latitude, longitude])
}

model SafetyGridCell {
  id                     String   @id @default(cuid())
  city                   String   @default("delhi")
  gridRow                Int
  gridCol                Int
  latitude               Float
  longitude              Float
  crimeRateWomen         Float    // 0-10 (crimes against women, 10=very high)
  streetLightDensity     Float    // 0-10 (10=well-lit)
  policeProximityScore   Float    // 0-10 (10=very close to station)
  wineShopProximityScore Float    // 0-10 (10=many nearby, worse safety)
  cctvCoverage           Float    // 0-10 (10=extensive)
  trafficDensity         Float    // 0-10 (10=heavy traffic, safer)
  nightRiskFactor        Float    // 0-1
  baseSafetyScore        Float    // XGBoost predicted: 0-100
  areaType               String   // residential, commercial, industrial, govt, mixed, slum
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([city, gridRow, gridCol])
  @@index([city])
  @@index([latitude, longitude])
  @@index([baseSafetyScore])
}